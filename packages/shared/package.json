{
	"name": "@app/shared",
	"version": "0.1.0",
	"private": true,
	"description": "Shared Zod schemas and TypeScript types for web and api.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=18.18"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "tsc -w -p tsconfig.build.json",
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.build.json --noEmit",
		"lint": "eslint ."
	},
	"dependencies": {
		"zod": "^4.3.6"
	}
}
