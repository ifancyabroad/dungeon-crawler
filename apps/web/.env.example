# Set to "true" to show the Debug drawer toggle on the Game page (dev only).
# Leave unset or "false" in production.
# VITE_DEBUG_DRAWER_ENABLED=false

# Optional: API base URL (defaults to /api when unset).
# VITE_API_BASE_URL=/api

# Must match DEBUG_SECRET in the API .env to authenticate debug requests.
# Leave unset in production. Only used when VITE_DEBUG_DRAWER_ENABLED=true.
# VITE_DEBUG_SECRET=
