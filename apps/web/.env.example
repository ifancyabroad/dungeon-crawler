# Base URL for static game assets (CloudFront/S3). No trailing slash.
# Committed in .env — update there if the URL changes.
# VITE_ASSETS_BASE_URL=https://your-distribution.cloudfront.net

# Optional: API base URL (defaults to /api when unset).
# VITE_API_BASE_URL=/api

# Local dev only — put these in .env.local (gitignored), never in .env.
# Must match DEBUG_SECRET in the API .env to authenticate debug requests.
# VITE_DEBUG_DRAWER_ENABLED=true
# VITE_DEBUG_SECRET=
