{
	"name": "@app/api",
	"version": "0.1.0",
	"private": true,
	"description": "Express + Mongoose API (TypeScript).",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=18.18"
	},
	"scripts": {
		"dev": "tsx watch ./src/server.ts",
		"build": "tsc -p tsconfig.json",
		"start": "node dist/server.js",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@app/shared": "workspace:*",
		"compression": "^1.8.1",
		"cors": "^2.8.6",
		"dotenv": "^17.2.3",
		"express": "^5.2.1",
		"helmet": "^8.1.0",
		"mongoose": "^9.1.5",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/compression": "^1.8.1",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^25.0.10",
		"tsx": "^4.21.0",
		"typescript": "~5.9.3",
		"vitest": "^4.0.18"
	}
}
