{
	"name": "dungeon-crawler",
	"version": "0.1.0",
	"private": true,
	"description": "Dungeon crawler game — MERN monorepo with React, Phaser, Express, and MongoDB.",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@10.14.0",
	"engines": {
		"node": ">=18.18"
	},
	"scripts": {
		"dev": "pnpm -r --parallel run dev",
		"build": "pnpm -r run build",
		"typecheck": "pnpm -r run typecheck",
		"lint": "pnpm -r run lint",
		"test": "pnpm -r run test",
		"format": "prettier -w .",
		"clean": "git clean -xfd -e node_modules",
		"prepare": "husky"
	},
	"devDependencies": {
		"@eslint/js": "^9.35.0",
		"eslint": "^9.35.0",
		"eslint-config-prettier": "^10.1.8",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.6",
		"prettier": "^3",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.43.0"
	}
}
